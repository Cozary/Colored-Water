{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version_fabric}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cozary.colored_water.ColoredWaterFabric"
    ],
    "client": [
      "com.cozary.colored_water.client.ColoredWaterClient",
      "com.cozary.colored_water.client.ParticleRegister"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
